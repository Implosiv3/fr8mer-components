{
    "compilerOptions": {
        "target": "es2023",
        "lib": ["ES2023", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",

        "jsx": "react-jsx",

        "types": ["vite/client"],

        "strict": true,
        "skipLibCheck": true,

        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,

        "declaration": true,
        "emitDeclarationOnly": true,

        "outDir": "./dist",
        "rootDir": "./src",

        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "erasableSyntaxOnly": true,
        "noFallthroughCasesInSwitch": true
    },

    "include": ["src"]
}